<%# Aperçu : le rendu est celui du candidat, mais la page ne contient aucun
    `<form>`. Il n'existe donc aucun bouton, aucune touche Entrée et aucun script
    capable de poster quoi que ce soit : la preview est fausse par construction,
    pas par convention. %>
<%# Le nom local ne peut pas être celui de la variable de locals : `const isPreview`
    = typeof isPreview…` se lirait dans sa propre zone morte et lèverait un
    ReferenceError sur le premier octet du rendu, pour le candidat comme pour
    l'aperçu. %>
<% const previewMode = typeof isPreview !== 'undefined' && isPreview; %>
<% const fillBackUrl = typeof backUrl !== 'undefined' ? backUrl : '/candidatures'; %>
<a href="<%= fillBackUrl %>" class="btn btn-outline btn-sm" style="width: fit-content;">Retour aux candidatures</a>

<section class="card" style="margin-top: 1rem;">
  <p class="eyebrow"><%= previewMode ? 'Aperçu du formulaire' : 'Formulaire' %></p>
  <h1 style="font-size: 1.8rem; margin: 0.35rem 0;"><%- renderDiscordInline(form.title) %></h1>
  <% if (form.description) { %>
    <p class="muted" style="margin-top: 0.5rem;"><%- renderDiscordInline(form.description) %></p>
  <% } %>
  <%# Une seule ligne, pas une par question : la barre de mise en forme
      apparaît de toute façon à la sélection, elle ne fait que nommer ce qui est
      possible. %>
  <p class="question-help" style="margin: 0.6rem 0 0;">Vos réponses acceptent le markdown Discord : sélectionnez un texte pour le mettre en forme (gras, italique, spoiler…).</p>
</section>

<%# Repli : un appelant qui n'a pas découpé le formulaire en pages est traité
    comme un formulaire d'une page unique, sans titre. %>
<%
  const pages = (form.pages && form.pages.length)
    ? form.pages
    : [{ position: 0, number: 1, count: 1, title: null, questions: form.questions || [] }];
  const multiPage = pages.length > 1;
%>

<%
  const accepted = typeof alreadyAccepted !== 'undefined' ? alreadyAccepted : false;
  const pending = typeof alreadySubmitted !== 'undefined' ? alreadySubmitted : false;
  // Toutes les routes qui rendent ce gabarit passent `answers`, mais une réponse
  // absente ne doit pas rendre la page illisible : `&&` sur un identifiant non
  // déclaré lèverait un ReferenceError au lieu de valoir false.
  const givenAnswers = typeof answers !== 'undefined' && answers ? answers : {};
%>
<% if (error) { %>
  <div class="notice notice-danger" style="margin-top: 1rem;"><%= error %></div>
<% } %>

<% if (previewMode) { %>
  <div class="notice notice-warning" style="margin-top: 1rem;">
    Aperçu : ceci est exactement ce que verra un candidat, mais rien n’est enregistré.
    Les champs sont là pour la démonstration et ne sont pas envoyés.
  </div>
<% } %>

<% if (accepted) { %>
  <section class="card" style="margin-top: 1rem;">
    <div class="empty-state">
      <span class="empty-state-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6.5 9.4 17.1 4 11.7"/></svg>
      </span>
      <p>Votre candidature a été acceptée sur ce formulaire. Vous ne pouvez donc plus y répondre.</p>
    </div>
  </section>
<% } else if (pending) { %>
  <section class="card" style="margin-top: 1rem;">
    <div class="empty-state">
      <span class="empty-state-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5"/><path d="M12 16h.01"/></svg>
      </span>
      <p>Vous avez déjà une candidature en attente sur ce formulaire. Elle sera traitée par l’équipe avant toute nouvelle soumission.</p>
    </div>
  </section>
<% } else { %>
  <% if (previewMode) { %>
    <div class="stack" id="form-pages" data-preview="1" style="margin-top: 1rem;">
  <% } else { %>
    <form action="/candidatures/<%= form.id %>/reponses" method="post" class="stack" id="form-pages" style="margin-top: 1rem;">
  <% } %>
    <%# La numérotation des questions reste globale sur tout le formulaire, même
        si elle est réinitialisée à chaque page : c'est l'ordre de lecture. %>
    <% let questionNumber = 0; %>
    <% pages.forEach((page, pageIndex) => { %>
      <section class="form-page" data-form-page="<%= pageIndex %>" aria-label="<%= page.title ? stripDiscordMarkdown(page.title) : 'Page ' + (pageIndex + 1) %>">
        <% if (page.title || multiPage) { %>
          <div class="page-head">
            <% if (page.title) { %>
              <h2 class="page-title"><%- renderDiscordInline(page.title) %></h2>
            <% } %>
            <% if (multiPage) { %>
              <p class="page-counter">Page <%= pageIndex + 1 %> sur <%= pages.length %></p>
            <% } %>
          </div>
        <% } %>

        <div class="stack">
          <% page.questions.forEach((question) => { %>
            <%
              questionNumber += 1;
              const raw = givenAnswers[String(question.id)];
              // Un choix multiple est stocké comme un tableau : la vue doit donc lire
              // les deux formes selon le type de la question.
              const value = question.fieldType === 'choice_multiple'
                ? (Array.isArray(raw) ? raw : [])
                : (Array.isArray(raw) ? (raw[0] || '') : (raw || ''));
              const options = Array.isArray(question.options) ? question.options : [];
            %>
            <article class="card">
              <div class="question-head">
                <span class="question-index"><%= questionNumber %></span>
                <div>
                  <h2 class="question-label"><%- renderDiscordInline(question.label) %></h2>
                  <% if (question.helpText) { %>
                    <p class="question-help"><%- renderDiscordInline(question.helpText) %></p>
                  <% } %>
                </div>
              </div>
              <%# L'illustration vient du créateur : une URL http(s) validée côté
                  serveur, jamais une donnée de candidature. %>
              <% if (question.imageUrl) { %>
                <img class="question-image" src="<%= question.imageUrl %>" alt="" loading="lazy">
              <% } %>
              <% if (question.fieldType === 'long') { %>
                <%# Seuls les champs de texte libre portent `data-md-field` : une
                    date ou une option de liste ne peut pas afficher de mise en
                    forme, et un markdown y resterait visible tel quel. %>
                <textarea class="field-input" name="answer_<%= question.id %>" data-md-field rows="6" placeholder="Votre réponse"><%= value %></textarea>
              <% } else if (question.fieldType === 'date') { %>
                <input class="field-input" type="date" name="answer_<%= question.id %>" value="<%= value %>">
              <% } else if (question.fieldType === 'choice_single') { %>
                <select class="field-input" name="answer_<%= question.id %>" <%= previewMode ? '' : 'required' %>>
                  <option value="">Choisissez une réponse</option>
                  <% options.forEach((option) => { %>
                    <option value="<%= option %>" <%= value === option ? 'selected' : '' %>><%= option %></option>
                  <% }); %>
                </select>
              <% } else if (question.fieldType === 'choice_multiple') { %>
                <%# Même `name` sur chaque case : le navigateur poste alors un tableau,
                    que le serveur range tel quel dans l'objet answers. %>
                <ul class="choice-list">
                  <% options.forEach((option) => { %>
                    <li class="choice-item">
                      <input type="checkbox" id="answer_<%= question.id %>-<%= options.indexOf(option) %>" name="answer_<%= question.id %>" value="<%= option %>" <%= value.includes(option) ? 'checked' : '' %>>
                      <label for="answer_<%= question.id %>-<%= options.indexOf(option) %>"><%= option %></label>
                    </li>
                  <% }); %>
                </ul>
              <% } else { %>
                <input class="field-input" type="text" name="answer_<%= question.id %>" data-md-field value="<%= value %>" placeholder="Votre réponse" maxlength="4000">
              <% } %>
            </article>
          <% }); %>

          <% if (!page.questions.length) { %>
            <div class="empty-state">
              <span class="empty-state-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 6h13M8 12h13M8 18h13"/></svg>
              </span>
              <p>Cette page ne contient aucune question.</p>
            </div>
          <% } %>
        </div>

        <%# Navigation : sans JavaScript, toutes les pages restent visibles et le
            seul bouton de validation est en bas — le formulaire reste donc
            remplissable et postable. %>
        <div class="row-aside page-nav">
          <% if (pageIndex > 0) { %>
            <button type="button" class="btn btn-outline page-nav-start" data-page-prev>Page précédente</button>
          <% } %>
          <% if (pageIndex < pages.length - 1) { %>
            <button type="button" class="btn btn-outline" data-page-next>Page suivante</button>
          <% } else if (previewMode) { %>
            <button type="button" class="btn btn-discord">Envoyer ma candidature</button>
          <% } else { %>
            <button type="submit" class="btn btn-discord">Envoyer ma candidature</button>
          <% } %>
        </div>
      </section>
    <% }); %>
  <% if (previewMode) { %>
    </div>
  <% } else { %>
    </form>
  <% } %>

  <script>
    /* Pagination : une amélioration, pas une condition d'utilisation. Le script ne
       s'installe qu'après coup et peut donc masquer les pages sans jamais empêcher
       l'affichage de l'ensemble du formulaire. */
    (function () {
      var root = document.getElementById('form-pages');
      if (!root) return;
      var pages = Array.prototype.slice.call(root.querySelectorAll('[data-form-page]'));
      if (pages.length < 2) return;
      root.classList.add('js-pages');

      var current = 0;

      function show(index) {
        current = Math.max(0, Math.min(index, pages.length - 1));
        pages.forEach(function (page, position) {
          page.classList.toggle('is-current', position === current);
        });
        root.querySelectorAll('[data-page-counter]').forEach(function (label) {
          label.textContent = String(current + 1);
        });
        if (root.scrollIntoView) root.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }

      /* La validation HTML ne porte que sur la page affichée : au premier envoi,
         on bascule sur la page fautive avant de laisser le navigateur la signaler,
         sinon il tenterait de faire le focus sur un champ caché. */
      function firstInvalidPage() {
        for (var index = 0; index < pages.length; index += 1) {
          if (pages[index].querySelector(':invalid')) return index;
        }
        return -1;
      }

      root.addEventListener('click', function (event) {
        var next = event.target.closest('[data-page-next]');
        if (next) {
          event.preventDefault();
          var invalid = firstInvalidPage();
          if (invalid !== -1 && invalid < pages.length - 1 && invalid !== current) {
            // Un champ obligatoire manquant bloque le passage : on montre la page
            // concernée plutôt que de laisser le candidat aller sur la suivante.
            show(invalid);
            var field = pages[invalid].querySelector(':invalid');
            if (field && field.reportValidity) field.reportValidity();
            return;
          }
          show(current + 1);
          return;
        }
        var previous = event.target.closest('[data-page-prev]');
        if (previous) {
          event.preventDefault();
          show(current - 1);
        }
      });

      var form = root.tagName === 'FORM' ? root : null;
      if (form) {
        form.addEventListener('submit', function (event) {
          var invalid = firstInvalidPage();
          if (invalid === -1) return;
          event.preventDefault();
          show(invalid);
          var field = pages[invalid].querySelector(':invalid');
          if (field && field.reportValidity) field.reportValidity();
        });
      }

      show(0);
    })();
  </script>
<% } %>
