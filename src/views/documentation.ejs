<%# Filigranes des trois cartes : dessins au trait, choisis via `card.key`. Très
    sombres et volontairement plus grands que la carte, ils débordent des bords
    et ne doivent jamais lire comme une icône. %>
<%
  const cardArtwork = {
    ethics: '<circle cx="80" cy="28" r="6"/><path d="M80 34v96"/><path d="M52 130h56"/><path d="M36 52h88"/><path d="M36 52 22 94"/><path d="M36 52 50 94"/><path d="M22 94a14 14 0 0 0 28 0"/><path d="M124 52 110 94"/><path d="M124 52 138 94"/><path d="M110 94a14 14 0 0 0 28 0"/>',
    facility: '<path d="M80 48C65 38 43 35 22 39v70c21-4 43-1 58 9 15-10 37-13 58-9V39c-21-4-43-1-58 9z"/><path d="M80 48v70"/><path d="M36 60c9-1 18 0 27 3"/><path d="M36 76c9-1 18 0 27 3"/><path d="M36 92c9-1 18 0 27 3"/><path d="M97 63c9 3 18 4 27 3"/><path d="M97 79c9 3 18 4 27 3"/><path d="M97 95c9 3 18 4 27 3"/>',
    discord: '<path d="M80 16 40 104h80z"/><path d="M61 66h38"/><path d="M26 104h108l8 16H18z"/>',
  };
%>

<%# Voile sombre + flou : la page reste visible dessous, la modale reste nette. %>
<div class="doc-overlay" aria-hidden="true"></div>

<section class="doc-panel" aria-labelledby="doc-title">
  <a class="doc-close" href="/" aria-label="Fermer la documentation">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </a>

  <header class="doc-head">
    <p class="eyebrow">Documentation</p>
    <h1 id="doc-title">Documentation de l’escadrille</h1>
    <p class="muted">Textes de référence et contacts de la Fondation.</p>
  </header>

  <div class="doc-grid">
    <% cards.forEach((card) => { %>
      <%# `url` est déjà validée et normalisée par la configuration serveur ;
          l'échappement EJS suffit à la tenir dans l'attribut. Sans URL, la carte
          reste lisible mais cesse d'être un lien (ancre sans href). %>
      <a class="card shortcut"<% if (card.url) { %> href="<%= card.url %>" target="_blank" rel="noopener noreferrer"<% } else { %> aria-disabled="true"<% } %>>
        <div>
          <h2><%= card.title %></h2>
          <p class="muted"><%= card.description %></p>
        </div>
        <svg class="doc-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        <span class="doc-art" data-art="<%= card.key %>" aria-hidden="true"><svg viewBox="0 0 160 160" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- cardArtwork[card.key] || cardArtwork.facility %></svg></span>
      </a>
    <% }) %>
  </div>
</section>
