<%# Voile sombre + flou : la page reste visible dessous, la modale reste nette. %>
<div class="doc-overlay" aria-hidden="true"></div>

<section class="doc-panel" aria-labelledby="doc-title">
  <a class="doc-close" href="/" aria-label="Fermer la documentation">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </a>

  <header class="doc-head">
    <p class="eyebrow">Documentation</p>
    <h1 id="doc-title">Documentation de l’escadrille</h1>
    <p class="muted">Textes de référence et contacts de la Fondation.</p>
  </header>

  <div class="doc-grid">
    <% cards.forEach((card) => { %>
      <%# `url` est déjà validée et normalisée par la configuration serveur ;
          l'échappement EJS suffit à la tenir dans l'attribut. Sans URL, la carte
          reste lisible mais cesse d'être un lien (ancre sans href). %>
      <a class="card shortcut"<% if (card.url) { %> href="<%= card.url %>" target="_blank" rel="noopener noreferrer"<% } else { %> aria-disabled="true"<% } %>>
        <div>
          <h2><%= card.title %></h2>
          <p class="muted"><%= card.description %></p>
        </div>
        <svg class="doc-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        <%# Panneau de la carte, en PNG : purement décoratif, donc sans
            alternative pour les lecteurs d'écran. Le nom du fichier suit
            `card.key` (src/public/img/doc-<key>.png). %>
        <img class="doc-art" data-art="<%= card.key %>" src="/img/doc-<%= card.key %>.png" alt="" aria-hidden="true">
      </a>
    <% }) %>
  </div>
</section>
