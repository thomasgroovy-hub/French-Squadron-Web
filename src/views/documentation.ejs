<section class="card">
  <p class="eyebrow">Documentation</p>
  <h1 style="font-size: 1.8rem; margin: 0.35rem 0;">Documentation de l’escadrille</h1>
  <p class="muted">Règlements, procédures et informations de référence.</p>
</section>

<% if (notice) { %>
  <div class="notice notice-success" style="margin-top: 1rem;"><%= notice %></div>
<% } %>
<% if (error) { %>
  <div class="notice notice-danger" style="margin-top: 1rem;"><%= error %></div>
<% } %>

<%
  /**
   * Rendu fidèle d'un bloc : c'est exactement le balisage publié dans la doc
   * publique, réutilisé dans la carte de gestion pour que l'aperçu corresponde
   * au résultat final. `isFormManager` vient du serveur, jamais de JS.
   */
  const iconPaths = {
    heading: '<path d="M6 4.5h12M6 10h12M6 15.5h7"/>',
    text: '<path d="M5 6h14M5 10h14M5 14h9"/>',
    link: '<path d="M10.5 13.5a3.5 3.5 0 0 0 5 0l2-2a3.5 3.5 0 0 0-5-5l-1 1"/><path d="M13.5 10.5a3.5 3.5 0 0 0-5 0l-2 2a3.5 3.5 0 0 0 5 5l1-1"/>',
    bullets: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01"/>',
  };
  const typeOrder = ['heading', 'text', 'link', 'bullets'];
  const typeLabels = { heading: 'Titre', text: 'Texte', link: 'Lien', bullets: 'Liste' };
  /** Champs utiles par type : pilote l'affichage dans le script de la page. */
  const fieldsFor = { heading: ['title'], text: ['content'], link: ['title', 'url'], bullets: ['content'] };
%>

<section class="card" style="margin-top: 1rem;">
  <div class="doc-block-list" id="doc-block-list">
    <% blocks.forEach((block, index) => { %>
      <article class="doc-block-card" data-tone="<%= block.tone %>" data-block-id="<%= block.id %>"<%= isFormManager ? ' draggable="true"' : '' %>>
        <div class="doc-card-head">
          <% if (isFormManager) { %>
            <span class="doc-card-grip" title="Glisser pour réordonner" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 6h.01M9 12h.01M9 18h.01M15 6h.01M15 12h.01M15 18h.01"/></svg>
            </span>
          <% } %>
          <span class="badge badge-<%= block.tone %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><%- iconPaths[block.icon] || iconPaths.text %></svg>
            <%= block.typeLabel %>
          </span>
          <% if (isFormManager) { %>
            <span class="question-index"><%= index + 1 %></span>
            <div class="doc-card-actions">
              <form action="/documentation/blocs/<%= block.id %>/deplacer" method="post">
                <button type="submit" name="direction" value="up" class="icon-btn" title="Monter" aria-label="Monter ce bloc"<%= index === 0 ? ' disabled' : '' %>>▲</button>
              </form>
              <form action="/documentation/blocs/<%= block.id %>/deplacer" method="post">
                <button type="submit" name="direction" value="down" class="icon-btn" title="Descendre" aria-label="Descendre ce bloc"<%= index === blocks.length - 1 ? ' disabled' : '' %>>▼</button>
              </form>
              <form action="/documentation/blocs/<%= block.id %>/supprimer" method="post" data-confirm="Supprimer ce bloc ?">
                <button type="submit" class="icon-btn icon-btn-danger" title="Supprimer le bloc" aria-label="Supprimer ce bloc">✕</button>
              </form>
            </div>
          <% } %>
        </div>

        <div class="doc-card-preview">
          <% if (block.type === 'heading') { %>
            <h2 class="doc-heading"><%= block.title %></h2>
          <% } else if (block.type === 'text') { %>
            <p class="doc-text"><%= block.content %></p>
          <% } else if (block.type === 'link') { %>
            <p class="doc-text">
              <a class="doc-link" href="<%= block.url %>" rel="noopener noreferrer" target="_blank"><%= block.title || block.url %></a>
            </p>
          <% } else if (block.type === 'bullets') { %>
            <ul class="doc-bullets">
              <% block.items.forEach((item) => { %>
                <li><%= item %></li>
              <% }); %>
            </ul>
          <% } %>
        </div>

        <% if (isFormManager) { %>
          <details class="doc-card-edit">
            <summary>Modifier</summary>
            <form action="/documentation/blocs/<%= block.id %>" method="post" class="doc-card-form" data-typed-form>
              <div class="doc-type-picker" data-type-picker>
                <% typeOrder.forEach((type) => { %>
                  <button type="button" class="btn btn-outline btn-sm" data-type="<%= type %>" aria-pressed="<%= block.type === type %>"><%= typeLabels[type] %></button>
                <% }); %>
              </div>

              <div class="field-block" data-legacy-type>
                <label class="field-label" for="doc-type-<%= block.id %>">Type de bloc</label>
                <select class="field-input" id="doc-type-<%= block.id %>" name="block_type">
                  <% typeOrder.forEach((type) => { %>
                    <option value="<%= type %>"<%= block.type === type ? ' selected' : '' %>><%= typeLabels[type] %></option>
                  <% }); %>
                </select>
              </div>

              <div class="field-block" data-field="title">
                <label class="field-label" for="doc-title-<%= block.id %>">Libellé</label>
                <input class="field-input" id="doc-title-<%= block.id %>" type="text" name="title" value="<%= block.title %>" maxlength="200" placeholder="Règlement intérieur">
              </div>
              <div class="field-block" data-field="content">
                <label class="field-label" for="doc-content-<%= block.id %>">Contenu</label>
                <p class="question-help">Pour une liste à puces, une ligne par élément.</p>
                <textarea class="field-input" id="doc-content-<%= block.id %>" name="content" rows="4" maxlength="4000" placeholder="Texte du bloc…"><%= block.content %></textarea>
              </div>
              <div class="field-block" data-field="url">
                <label class="field-label" for="doc-url-<%= block.id %>">URL</label>
                <p class="question-help">Seuls les liens http:// et https:// sont acceptés.</p>
                <input class="field-input" id="doc-url-<%= block.id %>" type="text" name="url" value="<%= block.url %>" maxlength="1024" placeholder="https://discord.com/channels/…">
              </div>

              <div class="row-aside" style="justify-content: flex-end;">
                <button type="submit" class="btn btn-primary btn-sm">Enregistrer</button>
              </div>
            </form>
          </details>
        <% } %>
      </article>
    <% }); %>

    <% if (!isFormManager && !blocks.length) { %>
      <%# Lecteur sur une doc vide : un message, mais jamais la carte de
          création, qui reste réservée à l'équipe Forms. %>
      <article class="doc-block-card" data-tone="neutral">
        <div class="empty-state">
          <span class="empty-state-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4.5h9l3.5 3.5V20H6z"/><path d="M15 4.5V8h3.5M9 12.5h6M9 16h6"/></svg>
          </span>
          <p>Aucun contenu n’a encore été publié. Revenez plus tard.</p>
        </div>
      </article>
    <% } %>

    <% if (isFormManager) { %>
      <%# Carte « en cours de création » : sur une doc vide elle est la première
          et unique carte, donc l'endroit où cliquer est immédiat. %>
      <article class="doc-block-card doc-new-card" data-tone="cyan" data-new-block>
        <div class="doc-card-head">
          <span class="badge badge-cyan">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Nouveau bloc
          </span>
        </div>

        <% if (!blocks.length) { %>
          <div class="empty-state">
            <span class="empty-state-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4.5h9l3.5 3.5V20H6z"/><path d="M15 4.5V8h3.5M9 12.5h6M9 16h6"/></svg>
            </span>
            <p>La documentation est vide. Choisissez un type ci-dessous pour créer votre premier bloc.</p>
          </div>
        <% } %>

        <details class="doc-card-edit" open>
          <summary>Ajouter un bloc</summary>
          <form action="/documentation/blocs" method="post" class="doc-card-form" data-typed-form>
            <div class="doc-type-picker" data-type-picker>
              <% typeOrder.forEach((type, position) => { %>
                <button type="button" class="btn btn-outline btn-sm" data-type="<%= type %>" aria-pressed="<%= position === 1 %>"><%= typeLabels[type] %></button>
              <% }); %>
            </div>

            <div class="field-block" data-legacy-type>
              <label class="field-label" for="doc-new-type">Type de bloc</label>
              <select class="field-input" id="doc-new-type" name="block_type">
                <% typeOrder.forEach((type) => { %>
                  <option value="<%= type %>"<%= type === 'text' ? ' selected' : '' %>><%= typeLabels[type] %></option>
                <% }); %>
              </select>
            </div>

            <div class="field-block" data-field="title">
              <label class="field-label" for="doc-new-title">Libellé</label>
              <input class="field-input" id="doc-new-title" type="text" name="title" value="" maxlength="200" placeholder="Règlement intérieur">
            </div>
            <div class="field-block" data-field="content">
              <label class="field-label" for="doc-new-content">Contenu</label>
              <p class="question-help">Pour une liste à puces, une ligne par élément.</p>
              <textarea class="field-input" id="doc-new-content" name="content" rows="4" maxlength="4000" placeholder="Texte du bloc…&#10;Règle 1&#10;Règle 2"></textarea>
            </div>
            <div class="field-block" data-field="url">
              <label class="field-label" for="doc-new-url">URL</label>
              <p class="question-help">Seuls les liens http:// et https:// sont acceptés.</p>
              <input class="field-input" id="doc-new-url" type="text" name="url" value="" maxlength="1024" placeholder="https://discord.com/channels/…">
            </div>

            <div class="row-aside" style="justify-content: flex-end;">
              <button type="submit" class="btn btn-primary btn-sm">Ajouter le bloc</button>
            </div>
          </form>
        </details>
      </article>

      <%# Un seul POST à la fin du glisser-déposer, pas un rechargement par étape. %>
      <form action="/documentation/blocs/reordonner" method="post" id="doc-reorder-form" hidden>
        <div id="doc-reorder-ids"></div>
      </form>
    <% } %>
  </div>
</section>

<% if (isFormManager) { %>
  <script>
    (function () {
      var list = document.getElementById('doc-block-list');
      if (!list) return;

      /* ---- Choix du type : seuls les champs utiles restent visibles -------
         Le <select> reste la seule source de vérité pour `block_type` : sans
         JavaScript il pilote déjà tout, avec JavaScript les boutons le
         pilotent et le select est masqué. Un seul champ de ce nom est donc
         soumis, dans les deux cas. */
      var fieldsFor = <%- JSON.stringify(fieldsFor) %>;

      function applyType(form, type) {
        var select = form.querySelector('select[name="block_type"]');
        if (select) select.value = type;
        form.querySelectorAll('[data-type-picker] button').forEach(function (button) {
          button.setAttribute('aria-pressed', String(button.getAttribute('data-type') === type));
        });
        var visible = fieldsFor[type] || [];
        form.querySelectorAll('[data-field]').forEach(function (field) {
          var shown = visible.indexOf(field.getAttribute('data-field')) !== -1;
          field.classList.toggle('doc-fields-hidden', !shown);
          // Un champ masqué ne doit pas être soumis, même si le serveur
          // ignorerait de toute façon ce qui ne correspond pas au type.
          field.querySelectorAll('input, textarea').forEach(function (input) {
            input.disabled = !shown;
          });
        });
      }

      list.querySelectorAll('[data-typed-form]').forEach(function (form) {
        var legacy = form.querySelector('[data-legacy-type]');
        if (legacy) legacy.hidden = true;
        form.querySelectorAll('[data-type-picker] button').forEach(function (button) {
          button.addEventListener('click', function () {
            applyType(form, button.getAttribute('data-type'));
          });
        });
        var select = form.querySelector('select[name="block_type"]');
        if (select) {
          select.addEventListener('change', function () { applyType(form, select.value); });
          applyType(form, select.value);
        }
      });

      /* ---- Réordonnancement : un POST à la fin du glisser-déposer -------- */
      var reorderForm = document.getElementById('doc-reorder-form');
      if (!reorderForm) return;
      var dragged = null;

      function cardOf(node) {
        return node && node.closest ? node.closest('.doc-block-card[data-block-id]') : null;
      }

      /* L'ordre du DOM fait foi : la numérotation et les bornes des boutons ▲▼
         sont recalculées avant l'envoi, pour que le repli sans JavaScript reste
         exact même après un glisser-déposer. */
      function renumber() {
        var cards = list.querySelectorAll('.doc-block-card[data-block-id]');
        cards.forEach(function (card, index) {
          var label = card.querySelector('.question-index');
          if (label) label.textContent = String(index + 1);
          var up = card.querySelector('button[value="up"]');
          var down = card.querySelector('button[value="down"]');
          if (up) up.disabled = index === 0;
          if (down) down.disabled = index === cards.length - 1;
        });
      }

      list.addEventListener('dragstart', function (event) {
        var card = cardOf(event.target);
        if (!card) return;
        dragged = card;
        card.classList.add('is-dragging');
        event.dataTransfer.effectAllowed = 'move';
        // Obligatoire sur Firefox, qui refuse de démarrer un drag sans payload.
        try { event.dataTransfer.setData('text/plain', ''); } catch (error) {}
      });

      list.addEventListener('dragover', function (event) {
        if (!dragged) return;
        event.preventDefault();
        event.dataTransfer.dropEffect = 'move';
        var target = cardOf(event.target);
        if (!target || target === dragged) return;
        var box = target.getBoundingClientRect();
        var after = (event.clientY - box.top) > box.height / 2;
        list.insertBefore(dragged, after ? target.nextSibling : target);
      });

      list.addEventListener('drop', function (event) {
        if (!dragged) return;
        event.preventDefault();
      });

      list.addEventListener('dragend', function () {
        if (!dragged) return;
        dragged.classList.remove('is-dragging');
        dragged = null;
        renumber();

        // Un seul envoi, avec l'ordre complet lu dans le DOM.
        var holder = document.getElementById('doc-reorder-ids');
        holder.textContent = '';
        list.querySelectorAll('.doc-block-card[data-block-id]').forEach(function (card) {
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'block_id';
          input.value = card.getAttribute('data-block-id');
          holder.appendChild(input);
        });
        reorderForm.submit();
      });
    })();
  </script>
<% } %>
