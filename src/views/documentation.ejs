<%# Icônes des trois cartes, dans le même trait que celles du dashboard. %>
<%
  const cardIcons = {
    ethics: '<path d="M12 4.2 5.5 6.4v5c0 4 2.7 7.3 6.5 8.4 3.8-1.1 6.5-4.4 6.5-8.4v-5z"/><path d="M9.4 12.1l1.9 1.9 3.4-3.6"/>',
    facility: '<path d="M6 4.5h9l3.5 3.5V20H6z"/><path d="M15 4.5V8h3.5M9 12.5h6M9 16h6"/>',
    discord: '<path d="M8.5 8.2A7 7 0 0 1 12 7.7a7 7 0 0 1 3.5.5"/><path d="M6.5 5.5 5.2 16a9 9 0 0 0 13.6 0l-1.3-10.5z"/><circle cx="10" cy="13.2" r="1"/><circle cx="14.4" cy="13.2" r="1"/><path d="M9.6 17.4c1.6.8 3.2.8 4.8 0"/>',
  };
%>

<section class="card">
  <p class="eyebrow">Documentation</p>
  <h1 style="font-size: 1.8rem; margin: 0.35rem 0;">Documentation de l’escadrille</h1>
  <p class="muted">Textes de référence et contacts de la Fondation.</p>
</section>

<div class="doc-grid">
  <% cards.forEach((card) => { %>
    <%# `url` est déjà validée et normalisée par la configuration serveur ;
        l'échappement EJS suffit à la tenir dans l'attribut. Sans URL, la carte
        reste lisible mais cesse d'être un lien (ancre sans href). %>
    <a class="card shortcut"<% if (card.url) { %> href="<%= card.url %>" target="_blank" rel="noopener noreferrer"<% } else { %> aria-disabled="true"<% } %>>
      <div>
        <span class="shortcut-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><%- cardIcons[card.key] || cardIcons.facility %></svg>
        </span>
        <h2 style="margin: 0.8rem 0 0.25rem;"><%= card.title %></h2>
        <p class="muted"><%= card.description %></p>
      </div>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  <% }) %>
</div>
