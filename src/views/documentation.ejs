<section class="card">
  <p class="eyebrow">Documentation</p>
  <h1 style="font-size: 1.8rem; margin: 0.35rem 0;">Documentation de l’escadrille</h1>
  <p class="muted">Règlements, procédures et informations de référence.</p>
</section>

<% if (notice) { %>
  <div class="notice notice-success" style="margin-top: 1rem;"><%= notice %></div>
<% } %>
<% if (error) { %>
  <div class="notice notice-danger" style="margin-top: 1rem;"><%= error %></div>
<% } %>

<%
  /**
   * Rendu fidèle d'un bloc : c'est exactement le balisage publié dans la doc
   * publique, réutilisé dans l'éditeur pour que l'aperçu corresponde au résultat
   * final. `isFormManager` vient du serveur, jamais de JS.
   *
   * Le bloc « Texte » passe par le markdown Discord, dont la fonction
   * échappe elle-même le texte : c'est pourquoi sa sortie est imprimée
   * telle quelle, sans double échappement de la part d'EJS.
   */
  const iconPaths = {
    heading: '<path d="M6 4.5h12M6 10h12M6 15.5h7"/>',
    text: '<path d="M5 6h14M5 10h14M5 14h9"/>',
    link: '<path d="M10.5 13.5a3.5 3.5 0 0 0 5 0l2-2a3.5 3.5 0 0 0-5-5l-1 1"/><path d="M13.5 10.5a3.5 3.5 0 0 0-5 0l-2 2a3.5 3.5 0 0 0 5 5l1-1"/>',
    bullets: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01"/>',
    separator: '<path d="M4 12h16"/>',
  };
  const typeOrder = ['heading', 'text', 'link', 'bullets', 'separator'];
  const typeLabels = { heading: 'Titre', text: 'Texte', link: 'Lien', bullets: 'Liste', separator: 'Séparateur' };
  /** Champs utiles par type : pilote l'affichage dans le script de la page. */
  const fieldsFor = {
    heading: ['title'],
    text: ['content'],
    link: ['title', 'url'],
    bullets: ['content'],
    separator: [],
  };
  /** Délimiteurs de la barre d'outils markdown, insérés autour de la sélection. */
  const mdTools = [
    { key: 'bold', open: '**', close: '**', label: 'G', title: 'Gras (Ctrl+B)' },
    { key: 'italic', open: '*', close: '*', label: 'I', title: 'Italique (Ctrl+I)' },
    { key: 'underline', open: '__', close: '__', label: 'S', title: 'Souligné' },
    { key: 'strike', open: '~~', close: '~~', label: 'K', title: 'Barré' },
  ];
%>

<section class="doc-editor-section" style="margin-top: 1rem;">
  <%
    /**
     * Les champs d'un bloc ne sont que normalisés côté serveur : `cleanText`
     * ne retire pas le HTML. Comme ce rendu est assemblé ici, tout ce qui
     * n'est pas du markdown doit donc être échappé explicitement, sinon un
     * titre deviendrait du balisage. Le contenu Markdown, lui, arrive déjà
     * échappé de `renderDiscordMarkdown`, qui est la seule source de HTML
     * autorisé dans cette page.
     */
    const HTML_ESCAPES = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, (character) => HTML_ESCAPES[character]);
    }

    /**
     * Rendu publié d'un bloc, sans aucun chrome d'édition. Partagé par la vue
     * publique et par l'éditeur, pour qu'il n'y ait qu'une seule description du
     * résultat final.
     */
    function renderBlockBody(block) {
      if (block.type === 'heading') return `<h2 class="doc-heading">${escapeHtml(block.title)}</h2>`;
      if (block.type === 'text') return renderDiscordMarkdown(block.content);
      if (block.type === 'link') return `<p class="doc-text"><a class="doc-link" href="${escapeHtml(block.url)}" rel="noopener noreferrer" target="_blank">${escapeHtml(block.title || block.url)}</a></p>`;
      if (block.type === 'bullets') return `<ul class="doc-bullets">${block.items.map((item) => `<li>${escapeHtml(item)}</li>`).join('')}</ul>`;
      if (block.type === 'separator') return '<hr class="doc-separator">';
      return '';
    }
  %>

  <div class="doc-editor" id="doc-editor">
    <% if (!blocks.length) { %>
      <div class="empty-state">
        <span class="empty-state-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 4.5h9l3.5 3.5V20H6z"/><path d="M15 4.5V8h3.5M9 12.5h6M9 16h6"/></svg>
        </span>
        <p><% if (isFormManager) { %>La documentation est vide. Survolez la page pour insérer votre premier bloc.<% } else { %>Aucun contenu n’a encore été publié. Revenez plus tard.<% } %></p>
      </div>
    <% } %>

    <% blocks.forEach((block, index) => { %>
      <div class="doc-row" data-block-id="<%= block.id %>" data-editing="false"<%= isFormManager ? ' draggable="true"' : '' %>>
        <% if (isFormManager) { %>
          <div class="doc-row-head">
            <span class="doc-row-grip" title="Glisser pour réordonner" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 6h.01M9 12h.01M9 18h.01M15 6h.01M15 12h.01M15 18h.01"/></svg>
            </span>
            <span class="badge badge-<%= block.tone %>">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><%- iconPaths[block.icon] || iconPaths.text %></svg>
              <%= block.typeLabel %>
            </span>
            <div class="doc-row-actions">
              <button type="button" class="icon-btn" data-action="edit" data-target="<%= block.id %>" title="Modifier" aria-label="Modifier ce bloc">✎</button>
              <form action="/documentation/blocs/<%= block.id %>/supprimer" method="post" data-confirm="Supprimer ce bloc ?">
                <button type="submit" class="icon-btn icon-btn-danger" title="Supprimer le bloc" aria-label="Supprimer ce bloc">✕</button>
              </form>
            </div>
          </div>
        <% } %>

        <div class="doc-row-body" data-doc-body><%- renderBlockBody(block) %></div>

        <% if (isFormManager) { %>
          <form class="doc-edit" action="/documentation/blocs/<%= block.id %>" method="post" data-doc-edit data-typed-form hidden>
            <div class="doc-insert-picker" data-type-picker role="group" aria-label="Type de bloc">
              <% typeOrder.forEach((type) => { %>
                <button type="button" data-type="<%= type %>" aria-label="<%= typeLabels[type] %>" aria-pressed="<%= block.type === type %>" title="<%= typeLabels[type] %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><%- iconPaths[type] %></svg></button>
              <% }); %>
            </div>

            <div class="field-block" data-legacy-type>
              <label class="field-label" for="doc-type-<%= block.id %>">Type de bloc</label>
              <select class="field-input" id="doc-type-<%= block.id %>" name="block_type">
                <% typeOrder.forEach((type) => { %>
                  <option value="<%= type %>"<%= block.type === type ? ' selected' : '' %>><%= typeLabels[type] %></option>
                <% }); %>
              </select>
            </div>

            <div class="field-block" data-field="title">
              <label class="field-label" for="doc-title-<%= block.id %>">Libellé</label>
              <input class="field-input" id="doc-title-<%= block.id %>" type="text" name="title" value="<%= block.title %>" maxlength="200" placeholder="Règlement intérieur">
            </div>
            <div class="field-block" data-field="content">
              <label class="field-label" for="doc-content-<%= block.id %>">Contenu</label>
              <div class="doc-toolbar" data-md-toolbar>
                <% mdTools.forEach((tool) => { %>
                  <button type="button" data-md="<%= tool.key %>" data-open="<%= tool.open %>" data-close="<%= tool.close %>" title="<%= tool.title %>" aria-label="<%= tool.title %>"><%= tool.label %></button>
                <% }); %>
              </div>
              <textarea class="field-input" id="doc-content-<%= block.id %>" name="content" rows="6" maxlength="4000" placeholder="**Gras**, *italique*, `code`&#10;- une liste&#10;&gt; une citation" data-md-input><%= block.content %></textarea>
              <p class="question-help">Markdown Discord : gras, italique, souligné, barré, code, listes, citations et liens.</p>
            </div>
            <div class="field-block" data-field="url">
              <label class="field-label" for="doc-url-<%= block.id %>">URL</label>
              <input class="field-input" id="doc-url-<%= block.id %>" type="text" name="url" value="<%= block.url %>" maxlength="1024" placeholder="https://discord.com/channels/…">
            </div>

            <div class="doc-edit-actions">
              <span class="question-help" style="margin-right: auto;">Ctrl+Entrée pour enregistrer, Échap pour annuler.</span>
              <button type="button" class="btn btn-outline btn-sm" data-action="cancel" data-target="<%= block.id %>">Annuler</button>
              <button type="submit" class="btn btn-primary btn-sm">Enregistrer</button>
            </div>
          </form>
        <% } %>
      </div>

      <% if (isFormManager && index < blocks.length - 1) { %>
        <%# Point d'insertion : `at` est le nombre de blocs déjà au-dessus, donc
            l'emplacement exact demandé, pas une simple mise à la fin. Le dernier
            point est rendu après la boucle pour éviter un doublon en bas. %>
        <div class="doc-insert" data-insert>
          <button type="button" class="doc-insert-btn" aria-expanded="false" aria-label="Insérer un bloc ici" title="Insérer un bloc ici">+</button>
          <form action="/documentation/blocs" method="post" class="doc-insert-form" data-typed-form data-insert-form hidden>
            <input type="hidden" name="at" value="<%= index + 1 %>">
            <div class="doc-insert-picker" data-type-picker role="group" aria-label="Type du bloc à insérer">
              <% typeOrder.forEach((type) => { %>
                  <button type="button" data-type="<%= type %>" aria-label="<%= typeLabels[type] %>" aria-pressed="false" title="<%= typeLabels[type] %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><%- iconPaths[type] %></svg></button>
              <% }); %>
            </div>
            <div class="field-block" data-legacy-type>
              <label class="field-label">Type de bloc</label>
              <select class="field-input" name="block_type">
                <% typeOrder.forEach((type) => { %>
                  <option value="<%= type %>"><%= typeLabels[type] %></option>
                <% }); %>
              </select>
            </div>
            <div class="doc-insert-fields" data-insert-details hidden>
              <div class="field-block" data-field="title">
                <label class="field-label">Libellé</label>
                <input class="field-input" type="text" name="title" maxlength="200" placeholder="Règlement intérieur">
              </div>
              <div class="field-block" data-field="content">
                <label class="field-label">Contenu</label>
                <textarea class="field-input" name="content" rows="4" maxlength="4000" placeholder="**Gras**, *italique*, `code`&#10;- une liste"></textarea>
              </div>
              <div class="field-block" data-field="url">
                <label class="field-label">URL</label>
                <input class="field-input" type="text" name="url" maxlength="1024" placeholder="https://discord.com/channels/…">
              </div>
              <div class="doc-edit-actions">
                <button type="button" class="btn btn-outline btn-sm" data-action="close-insert">Annuler</button>
                <button type="submit" class="btn btn-primary btn-sm">Ajouter ici</button>
              </div>
            </div>
          </form>
        </div>
      <% } %>
    <% }); %>

    <% if (isFormManager) { %>
      <%# Dernier emplacement : après le dernier bloc. %>
      <div class="doc-insert" data-insert>
        <button type="button" class="doc-insert-btn" aria-expanded="false" aria-label="Insérer un bloc ici" title="Insérer un bloc ici">+</button>
        <form action="/documentation/blocs" method="post" class="doc-insert-form" data-typed-form data-insert-form hidden>
          <input type="hidden" name="at" value="<%= blocks.length %>">
          <div class="doc-insert-picker" data-type-picker role="group" aria-label="Type du bloc à insérer">
            <% typeOrder.forEach((type) => { %>
              <button type="button" data-type="<%= type %>" aria-label="<%= typeLabels[type] %>" aria-pressed="false" title="<%= typeLabels[type] %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><%- iconPaths[type] %></svg></button>
            <% }); %>
          </div>
          <div class="field-block" data-legacy-type>
            <label class="field-label">Type de bloc</label>
            <select class="field-input" name="block_type">
              <% typeOrder.forEach((type) => { %>
                <option value="<%= type %>"><%= typeLabels[type] %></option>
              <% }); %>
            </select>
          </div>
          <div class="doc-insert-fields" data-insert-details hidden>
            <div class="field-block" data-field="title">
              <label class="field-label">Libellé</label>
              <input class="field-input" type="text" name="title" maxlength="200" placeholder="Règlement intérieur">
            </div>
            <div class="field-block" data-field="content">
              <label class="field-label">Contenu</label>
              <textarea class="field-input" name="content" rows="4" maxlength="4000" placeholder="**Gras**, *italique*, `code`&#10;- une liste"></textarea>
            </div>
            <div class="field-block" data-field="url">
              <label class="field-label">URL</label>
              <input class="field-input" type="text" name="url" maxlength="1024" placeholder="https://discord.com/channels/…">
            </div>
            <div class="doc-edit-actions">
              <button type="button" class="btn btn-outline btn-sm" data-action="close-insert">Annuler</button>
              <button type="submit" class="btn btn-primary btn-sm">Ajouter ici</button>
            </div>
          </div>
        </form>
      </div>

      <%# Sans JavaScript, seul le glisser-déposer disparaît : on rend les
          boutons de déplacement, que le script ne montre jamais. %>
      <noscript>
        <div class="doc-noscript">
          <p class="question-help">Sans JavaScript, déplacez les blocs avec ces boutons.</p>
          <% blocks.forEach((block, index) => { %>
            <div class="doc-noscript-row">
              <span class="muted">Bloc <%= index + 1 %></span>
              <form action="/documentation/blocs/<%= block.id %>/deplacer" method="post">
                <input type="hidden" name="direction" value="up">
                <button type="submit" class="icon-btn" title="Monter" aria-label="Monter ce bloc"<%= index === 0 ? ' disabled' : '' %>>▲</button>
              </form>
              <form action="/documentation/blocs/<%= block.id %>/deplacer" method="post">
                <input type="hidden" name="direction" value="down">
                <button type="submit" class="icon-btn" title="Descendre" aria-label="Descendre ce bloc"<%= index === blocks.length - 1 ? ' disabled' : '' %>>▼</button>
              </form>
            </div>
          <% }); %>
        </div>
      </noscript>

      <%# Un seul POST à la fin du glisser-déposer, pas un rechargement par étape. %>
      <form action="/documentation/blocs/reordonner" method="post" id="doc-reorder-form" hidden>
        <div id="doc-reorder-ids"></div>
      </form>
    <% } %>
  </div>
</section>

<% if (isFormManager) { %>
  <script>
    (function () {
      var editor = document.getElementById('doc-editor');
      if (!editor) return;

      /* ---- Choix du type : seuls les champs utiles restent visibles -------
         Le <select> reste la seule source de vérité pour `block_type` : sans
         JavaScript il pilote déjà tout, avec JavaScript les boutons le
         pilotent et le select est masqué. Un seul champ de ce nom est donc
         soumis, dans les deux cas. */
      var fieldsFor = <%- JSON.stringify(fieldsFor) %>;

      function applyType(form, type) {
        var select = form.querySelector('select[name="block_type"]');
        if (select) select.value = type;
        form.querySelectorAll('[data-type-picker] button').forEach(function (button) {
          button.setAttribute('aria-pressed', String(button.getAttribute('data-type') === type));
        });
        var visible = fieldsFor[type] || [];
        form.querySelectorAll('[data-field]').forEach(function (field) {
          var shown = visible.indexOf(field.getAttribute('data-field')) !== -1;
          field.classList.toggle('doc-fields-hidden', !shown);
          // Un champ masqué ne doit pas être soumis, même si le serveur
          // ignorerait de toute façon ce qui ne correspond pas au type.
          field.querySelectorAll('input, textarea').forEach(function (input) {
            input.disabled = !shown;
          });
        });
        var insertionDetails = form.querySelector('[data-insert-details]');
        if (insertionDetails) insertionDetails.hidden = !visible.length;
        return visible;
      }

      function firstVisibleField(form, fields) {
        for (var i = 0; i < fields.length; i += 1) {
          var field = form.querySelector('[data-field="' + fields[i] + '"] input, [data-field="' + fields[i] + '"] textarea');
          if (field) return field;
        }
        return null;
      }

      editor.querySelectorAll('[data-typed-form]').forEach(function (form) {
        var legacy = form.querySelector('[data-legacy-type]');
        if (legacy) legacy.hidden = true;
        form.querySelectorAll('[data-type-picker] button').forEach(function (button) {
          button.addEventListener('click', function () {
            applyType(form, button.getAttribute('data-type'));
          });
        });
        var select = form.querySelector('select[name="block_type"]');
        if (select) {
          select.addEventListener('change', function () { applyType(form, select.value); });
          if (form.hasAttribute('data-insert-form')) {
            // Ouvrir un point d'insertion ne révèle que les cinq types. Les
            // champs et l'action restent cachés jusqu'au choix d'un type.
            var insertionDetails = form.querySelector('[data-insert-details]');
            if (insertionDetails) insertionDetails.hidden = true;
            form.querySelectorAll('[data-field] input, [data-field] textarea').forEach(function (input) {
              input.disabled = true;
            });
          } else {
            applyType(form, select.value);
          }
        }
      });

      /* ---- Points d'insertion ------------------------------------------- */
      function closeInserts(except) {
        editor.querySelectorAll('[data-insert]').forEach(function (point) {
          if (point === except) return;
          var form = point.querySelector('[data-insert-form]');
          var button = point.querySelector('.doc-insert-btn');
          if (form) form.hidden = true;
          if (button) button.setAttribute('aria-expanded', 'false');
        });
      }

      editor.querySelectorAll('[data-insert]').forEach(function (point) {
        var button = point.querySelector('.doc-insert-btn');
        var form = point.querySelector('[data-insert-form]');
        if (!button || !form) return;

        button.addEventListener('click', function () {
          var willOpen = form.hidden;
          closeInserts(point);
          form.hidden = !willOpen;
          button.setAttribute('aria-expanded', String(willOpen));
          if (willOpen) {
            var firstChoice = form.querySelector('[data-type-picker] button');
            if (firstChoice) firstChoice.focus();
          }
        });

        // Choisir une icône remplit le type ; le séparateur part aussitôt.
        form.querySelectorAll('[data-type-picker] button').forEach(function (typeButton) {
          typeButton.addEventListener('click', function () {
            var type = typeButton.getAttribute('data-type');
            // L'écouteur générique met à jour le select et les champs avant
            // que cet écouteur place le focus ou insère un séparateur.
            var fields = fieldsFor[type] || [];
            if (!fields.length) {
              form.submit();
              return;
            }
            var target = firstVisibleField(form, fields);
            if (target) target.focus();
          });
        });
      });

      editor.addEventListener('click', function (event) {
        var close = event.target.closest('[data-action="close-insert"]');
        if (close) {
          var openForm = close.closest('[data-insert-form]');
          if (openForm) openForm.hidden = true;
          var trigger = close.closest('[data-insert]');
          if (trigger) {
            var triggerButton = trigger.querySelector('.doc-insert-btn');
            if (triggerButton) triggerButton.setAttribute('aria-expanded', 'false');
          }
        }
      });

      /* ---- Édition en place --------------------------------------------- */
      function openEditor(row) {
        row.dataset.editing = 'true';
        var form = row.querySelector('[data-doc-edit]');
        form.hidden = false;
        var type = form.querySelector('select[name="block_type"]').value;
        var fields = applyType(form, type);
        var target = firstVisibleField(form, fields);
        if (target) {
          target.focus();
          target.setSelectionRange(target.value.length, target.value.length);
        }
      }

      function closeEditor(row) {
        row.dataset.editing = 'false';
        row.querySelector('[data-doc-edit]').hidden = true;
      }

      function rowFor(element) {
        return element.closest ? element.closest('.doc-row') : null;
      }

      editor.addEventListener('click', function (event) {
        var action = event.target.closest('[data-action]');
        if (!action) return;
        var row = rowFor(action);
        if (!row) return;

        if (action.getAttribute('data-action') === 'edit') openEditor(row);
        else if (action.getAttribute('data-action') === 'cancel') closeEditor(row);
      });

      /* ---- Barre markdown : entoure la sélection -------------------------
         On n'utilise ni l'ancienne API de sélection, qui est dépréciée, ni
         le presse-papiers, qui refuse une sélection arbitraire : on écrit dans
         la value puis on replace le focus et la sélection. */
      function surround(area, open, close) {
        var start = area.selectionStart;
        var end = area.selectionEnd;
        var selected = area.value.slice(start, end);
        area.value = area.value.slice(0, start) + open + selected + close + area.value.slice(end);
        var caret = start + open.length;
        area.focus();
        area.setSelectionRange(caret, caret + selected.length);
      }

      editor.querySelectorAll('[data-md-toolbar]').forEach(function (toolbar) {
        toolbar.querySelectorAll('[data-md]').forEach(function (button) {
          button.addEventListener('mousedown', function (event) {
            // Le clic ne doit pas voler le focus du textarea avant le wrap.
            event.preventDefault();
            var area = toolbar.parentElement.querySelector('[data-md-input]');
            if (area) surround(area, button.getAttribute('data-open'), button.getAttribute('data-close'));
          });
        });
      });

      /* ---- Raccourcis : Ctrl+Entrée enregistre, Échap annule -------------- */
      editor.addEventListener('keydown', function (event) {
        var row = rowFor(event.target);
        if (!row) return;
        var form = row.querySelector('[data-doc-edit]');
        if (!form || form.hidden) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          closeEditor(row);
          return;
        }
        if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
          event.preventDefault();
          form.requestSubmit ? form.requestSubmit() : form.submit();
        }
      });

      /* ---- Réordonnancement : un POST à la fin du glisser-déposer -------- */
      var reorderForm = document.getElementById('doc-reorder-form');
      if (!reorderForm) return;
      var dragged = null;

      function rowOf(node) {
        return node && node.closest ? node.closest('.doc-row[data-block-id]') : null;
      }

      editor.addEventListener('dragstart', function (event) {
        var row = rowOf(event.target);
        if (!row) return;
        dragged = row;
        row.classList.add('is-dragging');
        event.dataTransfer.effectAllowed = 'move';
        // Obligatoire sur Firefox, qui refuse de démarrer un drag sans payload.
        try { event.dataTransfer.setData('text/plain', ''); } catch (error) {}
      });

      editor.addEventListener('dragover', function (event) {
        if (!dragged) return;
        event.preventDefault();
        event.dataTransfer.dropEffect = 'move';
        var target = rowOf(event.target);
        if (!target || target === dragged) return;
        var box = target.getBoundingClientRect();
        var after = (event.clientY - box.top) > box.height / 2;
        editor.insertBefore(dragged, after ? target.nextSibling : target);
      });

      editor.addEventListener('drop', function (event) {
        if (!dragged) return;
        event.preventDefault();
      });

      editor.addEventListener('dragend', function () {
        if (!dragged) return;
        dragged.classList.remove('is-dragging');
        dragged = null;

        // Un seul envoi, avec l'ordre complet lu dans le DOM.
        var holder = document.getElementById('doc-reorder-ids');
        holder.textContent = '';
        editor.querySelectorAll('.doc-row[data-block-id]').forEach(function (row) {
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'block_id';
          input.value = row.getAttribute('data-block-id');
          holder.appendChild(input);
        });
        reorderForm.submit();
      });
    })();
  </script>
<% } %>
