<div style="text-align: center; max-width: 680px; margin: 3rem auto 0;">
  <div style="display: inline-block; padding: 0.5rem 1rem; background: rgba(88, 101, 242, 0.1); border: 1px solid rgba(88, 101, 242, 0.25); border-radius: 999px; font-size: 0.85rem; color: var(--accent); margin-bottom: 1.5rem; font-weight: 600;">
