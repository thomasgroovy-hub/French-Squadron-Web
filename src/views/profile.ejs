<div style="display: flex; flex-direction: column; gap: 2rem;">
  <!-- En-tête Utilisateur -->
  <div class="card" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; background: linear-gradient(180deg, #1b222d 0%, #161b22 100%);">
    <div style="display: flex; align-items: center; gap: 1.25rem;">
      <img src="<%= discordInfo.avatarUrl %>" alt="<%= discordInfo.username %>" style="width: 72px; height: 72px; border-radius: 50%; border: 3px solid var(--border-focus); object-fit: cover;">
      <div>
        <h1 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem;">
          <%= discordInfo.globalName %>
        </h1>
        <p style="color: var(--text-muted); font-size: 0.95rem;">
          @<%= discordInfo.username %> • <code style="color: var(--cyan);"><%= discordInfo.id %></code>
        </p>
      </div>
    </div>

    <div>
      <% if (hasTargetRole) { %>
        <span class="badge badge-success" style="font-size: 0.85rem; padding: 0.4rem 0.85rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          Fiche Publique Active (Rôle <%= targetRoleId %>)
        </span>
      <% } else { %>
        <span class="badge badge-warning" style="font-size: 0.85rem; padding: 0.4rem 0.85rem;">
          Rôle <%= targetRoleId %> non détecté
        </span>
      <% } %>
    </div>
  </div>

  <!-- Cartes d'identité croisée Discord & Roblox -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
    <!-- Carte Discord -->
    <div class="card">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
        <h2 style="font-size: 1.15rem; font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="20" height="20" viewBox="0 0 127.14 96.36" fill="var(--accent)"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,45.91,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,45.91,96.12,53,91.08,65.69,84.69,65.69Z"/></svg>
          Identité Discord
        </h2>
        <span class="badge badge-cyan">Connecté</span>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.95rem;">
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem; display: block;">Utilisateur :</span>
          <strong><%= discordInfo.globalName %></strong> (<%= discordInfo.username %>)
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem; display: block;">Identifiant Discord :</span>
          <code><%= discordInfo.id %></code>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem; display: block;">Date de création :</span>
          <span><%= discordInfo.formattedCreatedAt %></span>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem; display: block;">Ancienneté du compte :</span>
          <span><%= discordInfo.accountAge %></span>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem; display: block;">Présence sur le serveur :</span>
          <% if (memberData.inGuild) { %>
            <span style="color: #3fb950;">Présent sur le serveur</span>
            <% if (memberData.nickname) { %>
              <span style="color: var(--text-muted); font-size: 0.85rem;">(Surnom : <%= memberData.nickname %>)</span>
            <% } %>
          <% } else { %>
            <span style="color: var(--warning);">Non détecté sur la guilde de modération</span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Carte Roblox -->
    <div class="card">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
        <h2 style="font-size: 1.15rem; font-weight: 600; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: #e02424;"><path d="M5.164 0 0 18.836l18.836 5.164L24 5.164 5.164 0zm8.99 14.846-5.842-1.602 1.602-5.842 5.842 1.602-1.602 5.842z"/></svg>
          Identité Roblox
        </h2>
        <% if (roblox.isLinked) { %>
          <span class="badge badge-success">Lié</span>
        <% } else { %>
          <span class="badge badge-warning">Non lié</span>
        <% } %>
      </div>

      <% if (roblox.isLinked && roblox.data) { %>
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <img src="<%= roblox.data.avatarUrl %>" alt="<%= roblox.data.username %>" style="width: 80px; height: 80px; border-radius: 8px; background: #0e1117; border: 1px solid var(--border); object-fit: cover;">
          <div style="display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.95rem; flex: 1;">
            <div>
              <span style="color: var(--text-muted); font-size: 0.85rem; display: block;">Pseudo Roblox :</span>
              <strong><%= roblox.data.username %></strong>
              <% if (roblox.data.displayName && roblox.data.displayName !== roblox.data.username) { %>
                <span style="color: var(--text-muted); font-size: 0.85rem;">(<%= roblox.data.displayName %>)</span>
              <% } %>
            </div>
            <div>
              <span style="color: var(--text-muted); font-size: 0.85rem; display: block;">ID Roblox :</span>
              <code><%= roblox.data.userId %></code>
            </div>
            <div>
              <span style="color: var(--text-muted); font-size: 0.85rem; display: block;">Compte créé le :</span>
              <span><%= roblox.data.formattedCreatedAt %></span>
            </div>
            <div>
              <span style="color: var(--text-muted); font-size: 0.85rem; display: block;">Ancienneté Roblox :</span>
              <span><%= roblox.data.accountAge %></span>
            </div>
            <% if (roblox.data.rank) { %>
              <div>
                <span style="color: var(--text-muted); font-size: 0.85rem; display: block;">Tag de vérification :</span>
                <code>#<%= roblox.data.rank %></code>
              </div>
            <% } %>
          </div>
        </div>
      <% } else { %>
        <div style="padding: 1rem 0; text-align: center; color: var(--text-muted);">
          <p style="margin-bottom: 0.75rem;">Ce compte Discord n’est associé à aucun compte Roblox enregistré en base.</p>
          <p style="font-size: 0.85rem;">
            Pour lier votre compte, utilisez la commande Discord <code>/verification-panel</code> sur le serveur officiel.
          </p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Section Conditionnelle : Fiche Personnelle Publique (/who-is) & Sanctions -->
  <% if (hasTargetRole) { %>
    <div class="card" style="border-left: 4px solid var(--border-focus);">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
        <div>
          <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.25rem;">
            Fiche Personnelle Publique
          </h2>
          <p style="color: var(--text-muted); font-size: 0.85rem;">
            Format conforme à la commande Discord <code>/who-is</code> • Accès accordé par le rôle <code><%= targetRoleId %></code>
          </p>
        </div>
        <span class="badge badge-cyan">
          <%= sanctions ? sanctions.totalCount : 0 %> sanction(s)
        </span>
      </div>

      <!-- Historique des Strikes / Avertissements -->
      <div style="margin-bottom: 2rem;">
        <h3 style="font-size: 1.05rem; font-weight: 600; margin-bottom: 0.75rem; color: #ff7b72; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Avertissements (table strikes)
        </h3>

        <% if (sanctions && sanctions.strikes.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <% sanctions.strikes.forEach(function(strike) { %>
              <div style="background: rgba(14, 17, 23, 0.7); border: 1px solid var(--border); border-radius: 6px; padding: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                  <strong style="color: var(--text-main); font-size: 0.95rem;">
                    Avertissement n°<%= strike.id %>
                  </strong>
                  <span style="color: var(--text-muted); font-size: 0.85rem;">
                    <%= strike.formattedDate %>
                  </span>
                </div>
                <div style="margin-bottom: 0.35rem; font-size: 0.9rem;">
                  <span style="color: var(--text-muted);">Raison :</span> <%= strike.reason %>
                </div>
                <div style="font-size: 0.85rem; color: var(--text-muted);">
                  Modérateur : <code style="color: var(--cyan);"><%= strike.moderatorId %></code>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p style="color: var(--text-muted); font-size: 0.9rem; background: rgba(14, 17, 23, 0.5); padding: 0.75rem 1rem; border-radius: 6px;">
            Aucun avertissement actif enregistré.
          </p>
        <% } %>
      </div>

      <!-- Autres sanctions (moderation_cases) si présentes -->
      <% if (sanctions && sanctions.cases.length > 0) { %>
        <div>
          <h3 style="font-size: 1.05rem; font-weight: 600; margin-bottom: 0.75rem; color: #e3b341; display: flex; align-items: center; gap: 0.5rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            Historique des autres sanctions (timeouts, exclusions, expulsions)
          </h3>

          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <% sanctions.cases.forEach(function(item) { %>
              <div style="background: rgba(14, 17, 23, 0.7); border: 1px solid var(--border); border-radius: 6px; padding: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                  <strong style="color: var(--text-main); font-size: 0.95rem; text-transform: capitalize;">
                    <%= item.type %>
                  </strong>
                  <span style="color: var(--text-muted); font-size: 0.85rem;">
                    <%= item.formattedDate %>
                  </span>
                </div>
                <div style="margin-bottom: 0.35rem; font-size: 0.9rem;">
                  <span style="color: var(--text-muted);">Raison :</span> <%= item.reason %>
                </div>
                <div style="font-size: 0.85rem; color: var(--text-muted);">
                  Modérateur : <code style="color: var(--cyan);"><%= item.moderatorId %></code>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <!-- Fiche restreinte si rôle absent -->
    <div class="card" style="border-left: 4px solid var(--warning); background: rgba(22, 27, 34, 0.85);">
      <div style="display: flex; align-items: flex-start; gap: 1rem;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="2" style="flex-shrink: 0; margin-top: 0.2rem;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <div>
          <h2 style="font-size: 1.15rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--text-main);">
            Fiche Personnelle Restreinte
          </h2>
          <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">
            L’accès à la fiche publique complète au format <code>/who-is</code> et au casier de sanctions nécessite le rôle Discord <code><%= targetRoleId %></code>.
            Ce rôle n’a pas été détecté sur votre profil lors de la vérification par le bot.
          </p>
        </div>
      </div>
    </div>
  <% } %>
</div>
