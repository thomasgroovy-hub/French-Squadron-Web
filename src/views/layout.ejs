<!DOCTYPE html>
<html lang="fr" data-theme="dark">
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#09090B" id="theme-color-meta">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title><%= typeof title !== 'undefined' ? title : 'Site-66' %></title>
  <script>
    /* Applique le thème avant le premier rendu : sans ce script, une page
       sombre clignoterait en clair le temps que laheet de style soit analysée. */
    (function () {
      var STORAGE_KEY = 'site66-theme';
      var stored = null;
      try { stored = window.localStorage.getItem(STORAGE_KEY); } catch (error) { stored = null; }
      /* Aucun choix enregistré = thème sombre par défaut. */
      var theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

    :root {
      --bg-main: #f7f7f8;
      --bg-card: #ffffff;
      --bg-subtle: #f0f1f3;
      --bg-pill: #f3f4f6;
      --bg-elevated: #ffffff;
      --border: #e5e7eb;
      --border-strong: #d1d5db;
      --text-main: #111827;
      --text-muted: #6b7280;
      --accent: #475569;
      --accent-hover: #64748b;
      --danger: #b91c1c;
      --danger-bg: #fee2e2;
      --warning: #b45309;
      --warning-bg: #fef3c7;
      --success: #15803d;
      --success-bg: #dcfce7;
      --radius: 12px;
      --radius-sm: 10px;
      --shadow: 0 1px 2px rgba(17, 24, 39, 0.04), 0 4px 14px rgba(17, 24, 39, 0.05);
      /* La documentation est une modale : elle garde son propre quasi-noir dans
         les deux thèmes, sinon elle ne ressemblerait plus à la référence. */
      --doc-panel: #09090B;
      --doc-card: #18181B;
      --doc-card-border: #303035;
      --doc-art: #252529;
      --doc-text: #F4F4F5;
      --doc-muted: #A1A1AA;
      --hero-ring: rgba(17, 24, 39, 0.06);
      --hero-ring-glow: rgba(17, 24, 39, 0.02);
      --theme-color: #f7f7f8;
    }

    /* Thème sombre — appliqué par défaut, surchargeable par data-theme="light". */
    [data-theme="dark"] {
      --bg-main: #09090B;
      --bg-card: #0F0F11;
      --bg-subtle: #111113;
      --bg-pill: #18181B;
      --bg-elevated: #27272A;
      --border: #27272A;
      --border-strong: #3F3F46;
      --text-main: #F4F4F5;
      --text-muted: #A1A1AA;
      --accent: #8A8A93;
      --accent-hover: #A1A1AA;
      --danger: #E53E3E;
      --danger-bg: #3A1C1C;
      --warning: #E5A00F;
      --warning-bg: #362A10;
      --success: #22C55E;
      --success-bg: #102C1E;
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 4px 14px rgba(0, 0, 0, 0.3);
      --doc-panel: #09090B;
      --doc-card: #18181B;
      --doc-card-border: #303035;
      --doc-art: #252529;
      --doc-text: #F4F4F5;
      --doc-muted: #A1A1AA;
      --hero-ring: rgba(232, 234, 237, 0.07);
      --hero-ring-glow: rgba(232, 234, 237, 0.025);
      --theme-color: #09090B;
    }

    [data-theme="light"] {
      color-scheme: light;
    }

    [data-theme="dark"] {
      color-scheme: dark;
    }

    /* Thème rose — easter egg, atteint en tapant « meow » sur le clavier. */
    [data-theme="rose"] {
      color-scheme: dark;
      --bg-main: #2a141c;
      --bg-card: #351922;
      --bg-subtle: #40202a;
      --bg-pill: #4a2531;
      --bg-elevated: #3d1d26;
      --border: #5c2f3d;
      --border-strong: #7a3f52;
      --text-main: #ffeef4;
      --text-muted: #d9a7b9;
      --accent: #ff9ebb;
      --accent-hover: #ffb8cd;
      --danger: #ff8fa8;
      --danger-bg: #4d1f2b;
      --warning: #ffc98a;
      --warning-bg: #4d3520;
      --success: #ffa8c4;
      --success-bg: #4a2130;
      --shadow: 0 1px 2px rgba(61, 15, 26, 0.4), 0 4px 14px rgba(61, 15, 26, 0.35);
      /* La documentation suit le thème actif, easter egg rose compris. */
      --doc-panel: #2a141c;
      --doc-card: #3d1d26;
      --doc-card-border: #5c2f3d;
      --doc-art: #4a2531;
      --doc-text: #ffeef4;
      --doc-muted: #d9a7b9;
      --hero-ring: rgba(255, 158, 187, 0.12);
      --hero-ring-glow: rgba(255, 158, 187, 0.04);
      --theme-color: #2a141c;
    }

    /* Le passage d'un thème à l'autre est instantané : pas de transition sur les
       couleurs, sinon le contenu « glisse » visuellement lors du basculement. */
    body, .navbar, .footer, .card, .field-input, .btn, .badge, .notice, .icon-btn {
      transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      position: relative;
      isolation: isolate;
      background: var(--bg-main);
      color: var(--text-main);
      font-family: "DM Sans", "Avenir Next", sans-serif;
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      transition: color 0.2s;
    }

    a:hover {
      text-decoration: underline;
    }

    .navbar {
      background: var(--bg-elevated);
      border-bottom: 1px solid var(--border);
      padding: 0.75rem max(1.25rem, calc((100vw - 1180px) / 2));
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-weight: 700;
      font-family: "Space Grotesk", sans-serif;
      font-size: 1rem;
      color: var(--text-main);
      text-decoration: none;
    }

    .nav-mark { width: 31px; height: 31px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-main); background: var(--bg-pill); font-size: 0.76rem; }
    .nav-start, .nav-tabs, .nav-user { display: flex; align-items: center; }
    .nav-start { gap: 1.6rem; min-width: 0; }
    .nav-tabs { gap: 0.2rem; }
    .nav-tab { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 0.8rem; border: 1px solid transparent; border-radius: 7px; color: var(--text-muted); font-size: 0.87rem; white-space: nowrap; transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease; }
    .nav-tab:hover, .nav-tab.is-active { color: var(--text-main); background: var(--bg-pill); border-color: var(--border); text-decoration: none; }
    .nav-tab.is-active { box-shadow: inset 0 -2px var(--accent); }
    .nav-soon { color: var(--text-muted); font-size: 0.68rem; }

    .nav-user {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-shrink: 0;
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.25rem 0.5rem;
      border-radius: 7px;
      font-size: 0.85rem;
    }

    .user-avatar-sm {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      object-fit: cover;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.55rem 1.1rem;
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-discord {
      background-color: var(--accent);
      color: #fff;
    }

    .btn-discord:hover {
      background-color: var(--accent-hover);
      text-decoration: none;
    }

    .btn-outline {
      background: transparent;
      border-color: var(--border);
      color: var(--text-muted);
    }

    .btn-outline:hover {
      background: var(--bg-subtle);
      color: var(--text-main);
      text-decoration: none;
    }

    .btn-sm {
      padding: 0.3rem 0.75rem;
      font-size: 0.8rem;
    }

    .container {
      max-width: 1180px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 3.5rem;
      flex: 1;
      width: 100%;
    }

    .footer {
      border-top: 1px solid var(--border);
      padding: 1.5rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
      background: var(--bg-elevated);
    }

    /* Utilitaires de cartes et mise en page */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow);
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .badge-success {
      background: var(--success-bg);
      border: 1px solid transparent;
      color: var(--success);
    }

    .badge-warning {
      background: var(--warning-bg);
      border: 1px solid transparent;
      color: var(--warning);
    }

    .badge-danger {
      background: var(--danger-bg);
      border: 1px solid transparent;
      color: var(--danger);
    }

    .badge-cyan {
      background: var(--bg-pill);
      border: 1px solid var(--border);
      color: var(--text-main);
    }

    h1, h2, h3 { font-family: "Space Grotesk", "DM Sans", sans-serif; letter-spacing: 0; }
    .btn { border-radius: var(--radius-sm); }
    .btn-discord { background: #526d68; color: #fff; }
    .btn-discord:hover { background: #62857c; }
    #theme-toggle { min-width: 2.35rem; padding: 0.3rem 0.5rem; line-height: 1; }
    #theme-toggle .theme-icon-sun, #theme-toggle .theme-icon-moon { font-size: 0.95rem; }
    /* Une seule icône visible à la fois, selon le thème actif. */
    [data-theme="dark"] #theme-toggle .theme-icon-sun { display: none; }
    [data-theme="light"] #theme-toggle .theme-icon-moon { display: none; }

    .eyebrow { color: var(--text-muted); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
    .muted { color: var(--text-muted); }
    .tag-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .role-tag { display: inline-flex; padding: 0.35rem 0.65rem; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-main); background: var(--bg-pill); font-size: 0.8rem; font-weight: 600; }
    .dashboard-hero { position: relative; overflow: hidden; min-height: 250px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; background: var(--bg-subtle); border-color: transparent; }
    /* L'anneau décoratif de l'accueil vit dans dashboard.ejs (headExtra) : il ne
       doit jamais pouvoir apparaître sur une autre page. */
    .hero-identity { display: flex; align-items: center; gap: 1.2rem; z-index: 1; }
    .hero-avatar { width: 76px; height: 76px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--border); background: var(--bg-subtle); }
    .hero-title { margin: 0.45rem 0; font-size: 2.25rem; line-height: 1.1; }
    .hero-note { max-width: 640px; color: var(--text-muted); }
    .dashboard-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.2rem; }
    .shortcut { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 130px; color: var(--text-main); transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease; }
    .shortcut:hover, .member-row:hover { border-color: var(--border-strong); transform: translateY(-2px); text-decoration: none; }
    .shortcut-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: var(--radius-sm); border: 1px solid var(--border); color: var(--accent); background: var(--bg-pill); }
    .shortcut svg { width: 20px; height: 20px; }
    .profile-avatar { width: 64px; height: 64px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--border); }
    .data-label { display: block; color: var(--text-muted); font-size: 0.78rem; }
    .member-tools { display: flex; gap: 0.65rem; margin-bottom: 1rem; }
    .member-tools input { flex: 1; min-width: 0; padding: 0.65rem 0.8rem; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-main); background: var(--bg-elevated); font: inherit; }
    .member-list { display: grid; gap: 0.65rem; }
    .member-row { display: grid; grid-template-columns: minmax(180px, 1.1fr) minmax(130px, 0.8fr) minmax(150px, 1.2fr) auto; align-items: center; gap: 1rem; padding: 0.8rem 1rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-elevated); color: var(--text-main); transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease; }
    .member-identity { display: flex; align-items: center; gap: 0.7rem; min-width: 0; }
    .member-avatar { width: 38px; height: 38px; border-radius: var(--radius-sm); object-fit: cover; background: var(--bg-subtle); }
    .legal-copy { max-width: 820px; }
    .legal-copy h2 { margin: 1.5rem 0 0.5rem; font-size: 1.08rem; }
    .legal-copy p, .legal-copy li { color: var(--text-muted); }
    .legal-copy ul { padding-left: 1.25rem; }
    .legal-copy a, .footer a { color: var(--accent); }
    /* Fiche profil : en-tête, colonnes, lignes de grades et de sanctions */
    .profile-identity { display: flex; align-items: center; gap: 1.1rem; min-width: 0; }
    .profile-identity-text { min-width: 0; }
    .profile-name { font-size: 1.9rem; font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; margin: 0; }
    .profile-handle { margin: 4px 0 0; color: var(--text-muted); font-size: 0.875rem; }
    .profile-meta { margin: 2px 0 0; color: var(--text-muted); font-size: 0.8rem; }
    .pill-row { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.85rem; }
    .pill {
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.25rem 0.6rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      background: var(--bg-pill);
      color: var(--text-main);
      font-size: 0.8125rem; font-weight: 500;
    }
    .pill svg { width: 13px; height: 13px; flex-shrink: 0; color: var(--text-muted); }
    .pill-mono { font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace; font-size: 0.78rem; }

    .profile-columns { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 1.25rem; align-items: start; }
    .profile-col { display: grid; gap: 1.25rem; min-width: 0; }

    .section-head { display: flex; align-items: center; gap: 0.5rem; padding-top: 1.1rem; margin-bottom: 0.85rem; border-top: 1px solid var(--border); }
    .section-head:first-child { padding-top: 0; border-top: 0; }
    .section-head svg { width: 15px; height: 15px; color: var(--text-muted); flex-shrink: 0; }
    .section-head h2 { font-size: 0.95rem; font-weight: 700; margin: 0; }

    .row-list { display: grid; gap: 0.5rem; }
    .data-row { display: flex; align-items: center; gap: 0.85rem; padding: 0.8rem 0.95rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-card); }
    .row-icon { width: 34px; height: 34px; flex-shrink: 0; display: grid; place-items: center; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-pill); color: var(--text-muted); }
    .row-icon svg { width: 16px; height: 16px; }
    .row-body { min-width: 0; flex: 1; }
    .row-title { font-weight: 600; font-size: 0.9rem; line-height: 1.3; }
    .row-subtitle { color: var(--text-muted); font-size: 0.78rem; margin-top: 2px; }
    .row-aside { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
    .row-date { color: var(--text-muted); font-size: 0.75rem; white-space: nowrap; }
    .row-avatar { width: 34px; height: 34px; flex-shrink: 0; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); background: var(--bg-subtle); }
    .toolbar { display: flex; flex-wrap: wrap; gap: 0.6rem; }

    /* Formulaires, candidatures et réponses */
    .stack { display: grid; gap: 1rem; }
    .field-block { display: grid; gap: 0.35rem; margin-bottom: 1.1rem; }
    .field-block:last-child { margin-bottom: 0; }
    .field-label { font-size: 0.82rem; font-weight: 600; color: var(--text-main); }
    .field-input { width: 100%; padding: 0.65rem 0.8rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-elevated); color: var(--text-main); font: inherit; font-size: 0.9rem; resize: vertical; }
    .field-input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
    .field-input:disabled { background: var(--bg-subtle); color: var(--text-muted); cursor: not-allowed; }

    .notice { padding: 0.75rem 1rem; border-radius: var(--radius-sm); font-size: 0.85rem; border: 1px solid transparent; }
    .notice-success { background: var(--success-bg); color: var(--success); border-color: rgba(21, 128, 61, 0.2); }
    .notice-danger { background: var(--danger-bg); color: var(--danger); border-color: rgba(220, 38, 38, 0.2); }
    .notice-warning { background: var(--warning-bg); color: var(--warning); border-color: rgba(180, 83, 9, 0.2); }

    .question-head { display: flex; align-items: flex-start; gap: 0.7rem; margin-bottom: 0.9rem; }
    .question-index { width: 24px; height: 24px; flex-shrink: 0; display: grid; place-items: center; border-radius: 50%; background: var(--bg-pill); border: 1px solid var(--border); color: var(--text-muted); font-size: 0.72rem; font-weight: 700; }
    .question-label { font-size: 0.98rem; font-weight: 600; line-height: 1.35; }
    .question-help { color: var(--text-muted); font-size: 0.8rem; margin-top: 3px; }

    .builder-row { display: flex; align-items: flex-start; gap: 0.85rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-elevated); }
    .builder-order { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; flex-shrink: 0; }
    .builder-body { flex: 1; min-width: 0; display: grid; gap: 0.3rem; }
    .builder-body .field-input { margin-bottom: 0.5rem; }
    .icon-btn { width: 26px; height: 26px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-pill); color: var(--text-muted); font-size: 0.65rem; cursor: pointer; transition: all 0.15s ease; }
    .icon-btn:hover:not(:disabled) { background: var(--bg-subtle); color: var(--text-main); }
    .icon-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .icon-btn-danger:hover:not(:disabled) { background: var(--danger-bg); color: var(--danger); border-color: rgba(220, 38, 38, 0.3); }

    /* Créateur de formulaire : poignée de drag, éditeur d'options, actions */
    .builder-handle { color: var(--text-muted); font-size: 0.95rem; line-height: 1; cursor: grab; user-select: none; }
    .builder-row.is-dragging { opacity: 0.5; border-color: var(--accent); }
    .builder-row[draggable="true"] .builder-handle:active { cursor: grabbing; }
    .builder-actions { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; flex-shrink: 0; }
    .option-row { display: flex; align-items: center; gap: 0.5rem; }
    .option-row .field-input { flex: 1; min-width: 0; }
    .option-editor[hidden] { display: none; }

    .answer-block { padding: 0.9rem 1rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-card); }
    .answer-label { display: flex; align-items: flex-start; gap: 0.7rem; margin-bottom: 0.6rem; }
    .answer-value { white-space: pre-wrap; line-height: 1.6; font-size: 0.9rem; color: var(--text-main); }
    /* Réponse à choix multiple : une puce par option retenue. */
    .answer-list { margin: 0; padding-left: 1.15rem; display: grid; gap: 0.25rem; font-size: 0.9rem; line-height: 1.6; color: var(--text-main); }
    .choice-list { margin: 0; padding: 0; display: grid; gap: 0.4rem; list-style: none; }
    .choice-item { display: flex; align-items: center; gap: 0.5rem; color: var(--text-main); font-size: 0.9rem; }
    .choice-item input { accent-color: var(--accent); }

    .stat-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; margin-bottom: 1rem; }
    .stat { display: grid; gap: 2px; padding: 0.7rem 0.85rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-pill); }
    .stat-value { font-family: "Space Grotesk", sans-serif; font-size: 1.25rem; font-weight: 700; line-height: 1.1; }
    .stat-label { color: var(--text-muted); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

    .detail-list { display: grid; gap: 0.6rem; margin: 0; }
    .detail-list > div { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline; justify-content: space-between; padding-bottom: 0.6rem; border-bottom: 1px solid var(--border); }
    .detail-list > div:last-child { padding-bottom: 0; border-bottom: 0; }
    .detail-list dt { color: var(--text-muted); font-size: 0.8rem; font-weight: 600; }
    .detail-list dd { margin: 0; font-size: 0.88rem; text-align: right; }

    /* Documentation : la page se lit comme une modale compacte posée sur le site
       flouté. Le voile, le panneau et la grille sont propres à cette page ; les
       cartes réutilisent `.card`/`.shortcut` de l'accueil, surchargés ici. */
    .doc-overlay { position: fixed; inset: 0; z-index: 200; background: rgba(9, 9, 11, 0.82); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
    .doc-panel { position: fixed; z-index: 201; top: 50%; left: 50%; transform: translate(-50%, -50%); width: min(520px, 92vw); max-height: calc(100vh - 2.5rem); overflow-y: auto; padding: 21px; background: var(--doc-panel); border: 1px solid var(--doc-card-border); border-radius: 13px; box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45); }
    .doc-close { position: absolute; top: 16px; right: 16px; width: 23px; height: 23px; display: grid; place-items: center; border: 1px solid var(--doc-card-border); border-radius: 5px; color: var(--doc-muted); transition: border-color 0.15s ease, color 0.15s ease; }
    .doc-close:hover { color: var(--doc-text); border-color: var(--doc-muted); text-decoration: none; }
    .doc-close:focus-visible { outline: 2px solid var(--doc-muted); outline-offset: 2px; }
    .doc-close svg { width: 13px; height: 13px; }
    .doc-head .eyebrow { font-size: 0.7rem; }
    .doc-head h1 { margin: 6px 0 4px; font-size: 17.5px; line-height: 1.2; color: var(--doc-text); }
    .doc-head .muted { margin: 0; font-size: 12.5px; color: var(--doc-muted); }

    .doc-grid { display: grid; gap: 12px; margin-top: 18px; }
    .doc-grid .shortcut { position: relative; overflow: hidden; min-height: 124px; align-items: center; padding: 14px 104px 14px 22px; background: var(--doc-card); border-color: var(--doc-card-border); border-radius: 10.5px; box-shadow: none; }
    .doc-grid .shortcut:hover { transform: none; }
    .doc-grid .shortcut > div { position: relative; z-index: 1; }
    .doc-grid .shortcut h2 { margin: 0 0 5px; font-size: 16.5px; line-height: 1.2; color: var(--doc-text); }
    .doc-grid .shortcut p { margin: 0; font-size: 11.5px; line-height: 1.5; color: var(--doc-muted); }
    /* La flèche reste en haut à droite, alignée sur les trois cartes. */
    .doc-grid .doc-arrow { position: absolute; top: 15px; right: 19px; width: 17px; height: 17px; color: var(--doc-muted); }
    /* Panneaux de la carte : PNG débordant des bords, décoratifs, jamais
       cliquables. `grayscale` + `opacity` les ramènent au ton du filigrane,
       quelle que soit la couleur du fichier d'origine.
       `will-change` isole le bitmap sur sa propre couche : le survol anime
       alors son opacité sur le compositeur, sans re-filtrer ni re-peindre un
       PNG 4x plus grand que la boîte à chaque image de la transition. */
    .doc-grid .doc-art { position: absolute; z-index: 0; display: block; pointer-events: none; object-fit: contain; filter: grayscale(1); opacity: 0.08; transition: opacity 0.15s ease; will-change: opacity, filter; }
    .doc-grid [data-art="ethics"] { top: -8px; right: -30px; width: 132px; height: 132px; }
    .doc-grid [data-art="facility"] { right: -34px; bottom: -40px; width: 150px; height: 150px; }
    .doc-grid [data-art="discord"] { right: -22px; bottom: -28px; width: 116px; height: 132px; }
    /* Survol : réservé aux pointeurs réels, et coupé si l'utilisateur a demandé
       moins d'animations. Sur tactile la carte reste neutre. */
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .doc-grid .shortcut:hover { border-color: var(--doc-muted); }
      .doc-grid .shortcut:hover .doc-art { opacity: 0.12; }
    }
    /* Carte sans URL configurée : lisible, mais plus cliquable. */
    .shortcut[aria-disabled="true"] { cursor: not-allowed; opacity: 0.55; }
    .shortcut[aria-disabled="true"]:hover { border-color: var(--border); transform: none; }
    .doc-grid .shortcut[aria-disabled="true"]:hover { border-color: var(--doc-card-border); }

    .empty-state { display: grid; justify-items: center; gap: 0.6rem; padding: 1.75rem 1rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-card); text-align: center; }
    .empty-state-icon { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: var(--bg-pill); color: var(--text-muted); }
    .empty-state-icon svg { width: 18px; height: 18px; }
    .empty-state p { color: var(--text-muted); font-size: 0.82rem; }

    @media (max-width: 780px) {
      .profile-columns { grid-template-columns: 1fr; }
      .profile-name { font-size: 1.5rem; }
      .navbar { align-items: flex-start; flex-wrap: wrap; padding: 0.65rem 1rem; }
      .nav-start { flex: 1 0 100%; justify-content: space-between; gap: 0.5rem; }
      .nav-tabs { gap: 0; overflow-x: auto; }
      .nav-tab { padding: 0.45rem 0.55rem; font-size: 0.79rem; }
      .nav-user { margin-left: auto; }
      .user-pill { display: none; }
      .container { padding: 1.5rem 1rem 2.5rem; }
      .dashboard-hero { align-items: flex-start; min-height: 0; }
      .member-row { grid-template-columns: minmax(0, 1fr) auto; }
      .member-roblox, .member-grades { grid-column: 1 / -1; }
      .stat-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .builder-row { flex-wrap: wrap; }
      .data-row { flex-wrap: wrap; }
      .data-row .row-aside { width: 100%; justify-content: flex-end; }
    }
    @media (max-width: 560px) {
      .nav-start { flex-direction: column; align-items: flex-start; }
      .nav-tabs { width: 100%; }
      .nav-user { position: absolute; top: 0.62rem; right: 1rem; }
      .nav-user .btn { padding: 0.38rem 0.6rem; }
      .hero-identity { align-items: flex-start; }
      .hero-avatar { width: 58px; height: 58px; }
      .hero-title { font-size: 1.65rem; }
      .dashboard-grid { grid-template-columns: 1fr; }
      .doc-panel { width: calc(100vw - 1.5rem); padding: 18px; }
      .doc-grid .shortcut { padding-right: 78px; }
      .doc-grid [data-art="ethics"] { width: 108px; height: 108px; }
      .doc-grid [data-art="facility"] { width: 122px; height: 122px; }
      .doc-grid [data-art="discord"] { width: 96px; height: 110px; }
      .member-tools { flex-wrap: wrap; }
    }
    /* Gestion des avertissements (comité d'éthique) */
    .strike-tools { margin-top: 0.6rem; }
    .strike-tools > summary {
      cursor: pointer;
      font-size: 0.78rem;
      color: var(--text-muted);
      list-style: none;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.2rem 0.5rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      width: fit-content;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .strike-tools > summary::-webkit-details-marker { display: none; }
    .strike-tools > summary::before { content: "✎"; font-size: 0.7rem; }
    .strike-tools > summary:hover { color: var(--text-main); border-color: var(--border-strong); }
    .strike-tools[open] > summary { margin-bottom: 0.6rem; }

    .strike-form { display: grid; gap: 0.4rem; margin-bottom: 0.5rem; }
    .strike-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
    }
    .strike-textarea {
      width: 100%;
      resize: vertical;
      font: inherit;
      font-size: 0.85rem;
      color: var(--text-main);
      background: var(--bg-subtle);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.5rem 0.6rem;
    }
    .strike-textarea:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }
    .strike-actions { display: flex; gap: 0.5rem; }
    .strike-add { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); }
    .btn-danger-text { color: var(--danger); }
    .btn-danger-text:hover { border-color: var(--danger); }

    /* Easter egg rose */
    [data-theme="rose"] .nav-mark { background: var(--accent); color: var(--bg-main); }

  </style>
<% if (currentPath === '/') { %>
  <style>
    /* Décoration propre à l'accueil. Elle vit ici, sous le garde-fou
       `currentPath === '/'`, pour ne jamais apparaître sur une autre page. */
    .dashboard-hero::after {
      content: "";
      position: absolute;
      width: 260px;
      height: 260px;
      right: 4%;
      top: -50%;
      border: 1px solid var(--hero-ring);
      border-radius: 50%;
      box-shadow:
        0 0 0 32px var(--hero-ring-glow),
        0 0 0 72px color-mix(in srgb, var(--hero-ring-glow) 55%, transparent);
      pointer-events: none;
    }

    @media (max-width: 768px) {
      .dashboard-hero::after {
        right: -16%;
        top: 30%;
      }
    }
  </style>
<% } %>
</head>
<body>
  <nav class="navbar">
    <div class="nav-start">
      <a href="/" class="nav-brand">
        <span class="nav-mark">S66</span>
        <span>Site-66</span>
      </a>
      <div class="nav-tabs" aria-label="Navigation principale">
        <a href="/" class="nav-tab <%= currentPath === '/' ? 'is-active' : '' %>">Accueil</a>
        <a href="/profile" class="nav-tab <%= currentPath === '/profile' ? 'is-active' : '' %>">Profil</a>
        <a href="/candidatures" class="nav-tab <%= currentPath.startsWith('/candidatures') ? 'is-active' : '' %>">Candidatures</a>
        <% if (typeof isFormManager !== 'undefined' && isFormManager) { %>
          <a href="/reponses" class="nav-tab <%= currentPath.startsWith('/reponses') ? 'is-active' : '' %>">Réponses</a>
        <% } %>
        <%# Onglet de supervision des formulaires : réservé aux rôles
            d'administration, qui voient tous les formulaires du site. %>
        <% if (typeof isFormsAdmin !== 'undefined' && isFormsAdmin) { %>
          <a href="/administration/formulaires" class="nav-tab <%= currentPath.startsWith('/administration') ? 'is-active' : '' %>">Administration</a>
        <% } %>
        <% if ((typeof isMemberManagement !== 'undefined' && isMemberManagement) || (typeof canManageStrikes !== 'undefined' && canManageStrikes)) { %>
          <a href="/members" class="nav-tab <%= currentPath.startsWith('/members') ? 'is-active' : '' %>">Supervision</a>
        <% } %>
      </div>
    </div>
    <div class="nav-user">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="user-pill">
          <% if (currentUser.avatarUrl) { %>
            <img src="<%= currentUser.avatarUrl %>" alt="<%= currentUser.username %>" class="user-avatar-sm">
          <% } %>
          <span><%= currentUser.globalName || currentUser.username %></span>
        </div>
        <a href="/auth/logout" class="btn btn-outline btn-sm">Déconnexion</a>
      <% } else { %>
        <a href="/auth/discord" class="btn btn-discord btn-sm">
          Connexion Discord
        </a>
      <% } %>
      <button id="theme-toggle" class="btn btn-outline btn-sm" type="button" aria-label="Basculer entre le mode sombre et le mode clair" title="Basculer le thème">
        <span class="theme-icon-sun" aria-hidden="true">☀️</span>
        <span class="theme-icon-moon" aria-hidden="true">🌙</span>
      </button>
    </div>
  </nav>

  <main class="container">
    <%- body %>
  </main>

  <footer class="footer">
    <span>Site-66 &copy; <%= new Date().getFullYear() %></span>
    <span> · <a href="/terms">Conditions d’utilisation</a> · <a href="/privacy">Confidentialité</a>
      <%# L'URL Discord vient de la configuration serveur (DISCORD_URL). Sans
          variable définie, on retombe sur un lien inerte plutôt que cassé. %>
      · <a href="<%= webConfig?.discordUrl || '#' %>" target="_blank" rel="noopener noreferrer">Discord</a>
      <%# TODO: remplacer par l'URL du groupe Roblox %>
      · <a href="#" target="_blank" rel="noopener noreferrer">Roblox</a>
    </span>
  </footer>
  <script>
    (function () {
      var STORAGE_KEY = 'site66-theme';
      var ROSE_KEY = 'site66-rose';
      var THEMES = ['light', 'dark', 'rose'];
      var toggle = document.getElementById('theme-toggle');
      var meta = document.getElementById('theme-color-meta');
      if (!toggle) return;

      function isRose() {
        return document.documentElement.getAttribute('data-theme') === 'rose';
      }

      function applyTheme(theme) {
        var resolved = THEMES.indexOf(theme) === -1 ? 'dark' : theme;
        document.documentElement.setAttribute('data-theme', resolved);
        if (meta) {
          meta.setAttribute('content', getComputedStyle(document.documentElement).getPropertyValue('--theme-color').trim() || (resolved === 'light' ? '#f7f7f8' : '#09090B'));
        }
        try { window.localStorage.setItem(STORAGE_KEY, resolved); } catch (error) {}
        toggle.setAttribute('aria-pressed', resolved === 'light' ? 'true' : 'false');
        toggle.setAttribute('title', isRose() ? 'Quitter le thème rose' : 'Basculer le thème');
      }

      var stored = null;
      try { stored = window.localStorage.getItem(STORAGE_KEY); } catch (error) {}
      applyTheme(stored || document.documentElement.getAttribute('data-theme') || 'dark');

      toggle.addEventListener('click', function () {
        // From rose, the button is the way out: it returns to dark.
        var next = isRose() ? 'dark' : (document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light');
        applyTheme(next);
        if (isRose()) { try { window.localStorage.removeItem(ROSE_KEY); } catch (error) {} }
      });

      // ── Easter egg : taper « meow » n'importe où bascule le site en rose.
      var buffer = '';
      var lastKeyAt = 0;
      document.addEventListener('keydown', function (event) {
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        var target = event.target;
        var tag = target && target.tagName ? target.tagName.toLowerCase() : '';
        if (tag === 'input' || tag === 'textarea' || tag === 'select' || (target && target.isContentEditable)) return;

        var now = Date.now();
        if (now - lastKeyAt > 1500) buffer = '';
        lastKeyAt = now;

        if (event.key && event.key.length === 1) {
          buffer = (buffer + event.key.toLowerCase()).slice(-4);
          if (buffer === 'meow' && !isRose()) {
            applyTheme('rose');
            try { window.localStorage.setItem(ROSE_KEY, '1'); } catch (error) {}
          }
        } else if (event.key === 'Backspace') {
          buffer = buffer.slice(0, -1);
        }
      });

      // Suppression d'un avertissement : confirmation explicite, le bouton
      // d'envoi ne doit pas se déclencher au premier clic.
      document.addEventListener('submit', function (event) {
        var form = event.target;
        if (!form || !form.dataset || !form.dataset.confirm) return;
        if (!window.confirm(form.dataset.confirm)) event.preventDefault();
      });
    })();
  </script>
  <script>
    // Salutation variable selon l'heure LOCALE du visiteur. Le serveur ne peut
    // pas la deviner (Render tourne en UTC), et personne n'a envie de stocker
    // un fuseau horaire pour cela : tout se calcule dans le navigateur.
    (function () {
      var el = document.getElementById('dashboard-greeting');
      if (!el) return;
      var name = el.dataset.name || '';

      // Bornes en heure LOCALE du visiteur (0-23). Plusieurs formulations par
      // tranche, choisies au hasard à chaque chargement pour éviter la
      // monotonie, sans emoji ni tiret cadratin (cohérent avec le reste du site).
      var BRACKETS = [
        { start: 0, end: 5, greetings: ['Bonne nuit', 'Toujours par ici à cette heure', 'Bonsoir'] },
        { start: 5, end: 12, greetings: ['Bonjour', 'Bon matin', 'Bonne journée'] },
        { start: 12, end: 14, greetings: ['Bonjour', 'Bon appétit', 'Bonne pause déjeuner'] },
        { start: 14, end: 18, greetings: ['Bonjour', 'Bon après-midi'] },
        { start: 18, end: 22, greetings: ['Bonsoir', 'Bonne soirée'] },
        { start: 22, end: 24, greetings: ['Bonsoir', 'Bonne nuit', 'Encore par ici à cette heure'] },
      ];

      var hour = new Date().getHours();
      var bracket = BRACKETS.find(function (b) { return hour >= b.start && hour < b.end; }) || BRACKETS[1];
      var options = bracket.greetings;
      var greeting = options[Math.floor(Math.random() * options.length)];

      el.textContent = name ? (greeting + ', ' + name) : greeting;
    })();
  </script>
</body>
</html>
