# Web Companion / OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
# Doit correspondre exactement à l'URI déclarée dans le portail OAuth2 de l'application Discord.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Aucune valeur par défaut : une clé absente empêche la signature des cookies de session.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
WEB_PORT=3000
DISCORD_GUILD_ID=1487258655840669807
# Rôle donnant accès au panneau de sanctions sur une fiche profil.
WEB_TARGET_ROLE_ID=1553099793532854382

# Candidatures, réponses et documentation.
# Rôle totalement indépendant de WEB_TARGET_ROLE_ID : ni parent, ni enfant, ni substitution.
WEB_FORMS_ROLE_ID=1532037579816570981
WEB_FORMS_PUBLISH_COOLDOWN_MINUTES=30

# MySQL Database
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
