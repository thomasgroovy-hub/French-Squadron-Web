# Web Companion / OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
# Doit correspondre exactement à l'URI déclarée dans le portail OAuth2 de l'application Discord.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Aucune valeur par défaut : une clé absente empêche la signature des cookies de session.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
WEB_PORT=3000
DISCORD_GUILD_ID=1487258655840669807
# Rôle donnant accès au panneau de sanctions sur une fiche profil.
WEB_TARGET_ROLE_ID=1553099793532854382

# Candidatures, réponses et documentation.
# Rôle totalement indépendant de WEB_TARGET_ROLE_ID : ni parent, ni enfant, ni substitution.
WEB_FORMS_ROLE_ID=1532037579816570981
WEB_FORMS_PUBLISH_COOLDOWN_MINUTES=30

# Onglet Supervision (/members) : annuaire des membres, Deaths et sanctions
# des autres fiches. Rôle distinct de WEB_TARGET_ROLE_ID, qui ne donne accès
# qu'à l'historique des sanctions sur sa propre fiche profil.
WEB_MEMBER_MANAGEMENT_ROLE_ID=1487266203864006707

# MySQL Database
# Pool principal : forms, réponses, documentation, sanctions, Deaths, site_users.
# Si une seule de ces variables manque, le serveur refuse de démarrer et nomme
# celle qui manque dans les logs.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Base du site (miroir écrit par le bot). Facultatif : sans ces variables le
# site démarre, mais la vérification Roblox et l'annuaire des membres
#traitent chaque membre comme non lié.
SITE_MYSQL_HOST=
SITE_MYSQL_PORT=3306
SITE_MYSQL_USER=
SITE_MYSQL_PASSWORD=
SITE_MYSQL_DATABASE=

# Secret HMAC du webhook Deaths (POST /v1/roblox/permadeath-death).
PERMADEATH_WEBHOOK_SECRET=
